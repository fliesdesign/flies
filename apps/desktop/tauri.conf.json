{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flies",
  "mainBinaryName": "Flies",
  "version": "0.2.3",
  "identifier": "com.flies.app",
  "build": {
    "beforeDevCommand": "vp -C ../web dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "vp -C ../web build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Flies",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 20 },
        "dragDropEnabled": false,
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCN0MxQUQwMTIyOUZCM0IKUldRNyt5a1MwQnA4aTFGNUlNekhHZWc5Q3lUWERTVDQzd2MwZE9QcENqRGpBb3Njb3krNlYxdHAK",
      "endpoints": ["https://github.com/lassejlv/flies/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
