{
  "name": "@flies/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/unit.test.ts test/billing.test.ts test/realtime.test.ts test/revisions.test.ts",
    "test:revisions": "bun test test/revisions.integration.test.ts",
    "test:integration": "bun --env-file=../../.env test test/integration.test.ts",
    "db:generate": "bun --env-file=../../.env x drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env src/db/migrate.ts",
    "test:realtime": "bun --env-file=../../.env test test/realtime.integration.test.ts"
  },
  "dependencies": {
    "@flies/canvas": "workspace:*",
    "@flies/sync": "workspace:*",
    "@polar-sh/sdk": "^0.49.0",
    "@workos-inc/node": "^10.13.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "standardwebhooks": "^1.1.1",
    "ulid": "^3.0.2",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "~6.0.3"
  }
}
