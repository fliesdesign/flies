{
  "name": "flies",
  "version": "0.2.10",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp -C apps/web dev",
    "build": "vp run --filter ./apps/web build",
    "preview": "vp -C apps/web preview",
    "typecheck": "vp run --filter ./packages/canvas --filter ./packages/html --filter ./apps/web typecheck && bun run --cwd apps/api typecheck",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt && vp lint -A all -D stylistic/padding-line-between-statements -D stylistic/lines-between-class-members --fix && vp fmt",
    "format:check": "vp fmt --check && vp lint -A all -D stylistic/padding-line-between-statements -D stylistic/lines-between-class-members",
    "check": "vp check && bun run typecheck",
    "tauri": "bun run --cwd apps/desktop tauri",
    "tauri:dev": "bun run --cwd apps/desktop tauri:dev",
    "tauri:build": "bun run --cwd apps/desktop tauri:build",
    "test": "vp run --filter ./packages/canvas --filter ./packages/html --filter ./apps/web test && bun run --cwd apps/api test",
    "test:mcp": "playwright test --config playwright.mcp.config.ts",
    "test:gpu": "playwright test --config playwright.gpu.config.ts",
    "benchmark:canvas": "bun scripts/benchmark-canvas.ts",
    "benchmark:build": "bun run --cwd apps/web benchmark:build",
    "benchmark:preview": "bun run --cwd apps/web benchmark:preview",
    "api:dev": "bun run --cwd apps/api dev",
    "api:start": "bun run --cwd apps/api start",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "test:api:integration": "bun run --cwd apps/api test:integration",
    "test:source:production": "playwright test --config playwright.source.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.2",
    "typescript": "~6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  },
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3",
    "vite-plus": "0.3.3"
  },
  "patchedDependencies": {
    "pixi.js@8.21.0": "patches/pixi.js@8.21.0.patch"
  }
}
