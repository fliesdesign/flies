# Backend only; never use VITE_ prefixes for secrets.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=http://localhost:3001/auth/callback
API_URL=http://localhost:3001
WEB_URL=http://localhost:1420
PORT=3001
DATABASE_URL=
TEST_DATABASE_URL=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=development
# Separate-origin web and desktop production builds require the public HTTPS API URL.
# Browsers use the same-origin /api and /auth reverse proxy by default.
# VITE_API_URL=https://board.flies.design
# Caddy production upstream, e.g. api.railway.internal:3001
API_UPSTREAM=localhost:3001

# Optional billing. Leave ALL POLAR_* values unset/empty to disable billing and quotas.
# If any is set, the four credentials/IDs below are required.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRO_PRODUCT_ID=
POLAR_ORGANIZATION_ID=
# Optional when enabled: production (default) or sandbox.
# POLAR_SERVER=production
# Flies production Pro: 14e2d2c3-fa2d-4b26-a686-30efbebbcf1b
# Flies production organization: be8119a2-23a8-4edf-ab4c-5edd1ba71ccf

# Optional realtime collaboration; all three values are required when enabled.
# Upstash Redis REST credentials stay on the API server.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate once: openssl rand -base64 32. Share only between API replicas.
SYNC_ENCRYPTION_KEY=
